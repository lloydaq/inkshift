{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "noEmit": true,
    // The demo imports the package by name; resolve it to source (as demo/vite.config.ts
    // does) so type checking never depends on a previous build of dist/.
    "paths": {
      "inkshift": ["./src/index.ts"],
      "inkshift/react": ["./src/react/index.ts"]
    }
  },
  "include": ["src", "tests", "demo", "scripts", "*.ts"]
}
